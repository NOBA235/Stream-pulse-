generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Stream {
  id            String        @id @default(cuid())
  name          String
  description   String?
  lat           Float
  lng           Float
  observations  Observation[]
}

model Observation {
  id                       String   @id @default(cuid())
  streamId                 String
  stream                   Stream   @relation(fields: [streamId], references: [id])
  timestamp                DateTime
  waterClarity             Float    // 0-100 (% transparency)
  pH                       Float
  temperature              Float    // deg C
  macroinvertebrateScore   Int      // 0-10 (pollution-sensitive taxa index)
  pollutionSigns           String?  // comma-separated: trash,odor,algae,oil sheen
  habitatScore             Int      // 0-100
  notes                    String?
  healthScore              Float?   // computed on create
}
